{
  "name": "todo-assessment",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "db:generate": "node --env-file-if-exists=.env node_modules/prisma/build/index.js generate",
    "db:migrate": "node --env-file-if-exists=.env node_modules/prisma/build/index.js migrate dev",
    "db:deploy": "node --env-file-if-exists=.env node_modules/prisma/build/index.js migrate deploy",
    "dev:server": "node scripts/dev-server.mjs",
    "dev:client": "vite --host 127.0.0.1",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:components": "vitest run --project components",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.server.json && tsc --noEmit -p tsconfig.client.json && tsc --noEmit -p tsconfig.tests.json",
    "lint": "eslint .",
    "build": "npm run db:generate && tsc -p tsconfig.server.json && vite build",
    "start": "node --env-file-if-exists=.env dist/server/index.js"
  },
  "dependencies": {
    "express": "5.3.0",
    "react": "19.1.10",
    "react-dom": "19.1.10",
    "zod": "4.6.7",
    "react-hook-form": "7.91.0",
    "@hookform/resolvers": "5.9.2",
    "axios": "1.21.0",
    "@prisma/client": "7.10.1",
    "@prisma/adapter-better-sqlite3": "7.10.1"
  },
  "devDependencies": {
    "prisma": "7.10.1",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "3.2.7",
    "supertest": "7.3.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/dom": "10.4.2",
    "jsdom": "26.1.0",
    "eslint": "9.39.5",
    "@eslint/js": "9.39.5",
    "typescript-eslint": "8.72.1",
    "@types/node": "24.19.2",
    "@types/express": "5.0.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/supertest": "6.0.3"
  }
}
